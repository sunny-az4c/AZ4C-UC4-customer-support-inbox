# Copy this file to .env and add your keys. Never commit .env.
# Read these four values from the environment. Don't hard-code a key or a
# provider address.
#
# Groq: the groq SDK reads GROQ_API_KEY and GROQ_BASE_URL by itself.
#   With an OpenAI-compatible client, use base_url = GROQ_BASE_URL + "/openai/v1".
# Gemini: with google-genai, pass GEMINI_BASE_URL as http_options base_url.
#   With an OpenAI-compatible client, use base_url = GEMINI_BASE_URL + "/v1beta/openai/".
#
# Add any other settings your system needs below, without values.

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---- Optional. Leave empty to use the default shown in the comment above each one.
# Folder holding data/ and docs/ (default: the repository root).
DATA_DIR=
# Where tickets and refund requests are written (default: <repository root>/mock_system).
MOCK_SYSTEM_DIR=
# Models (defaults: openai/gpt-oss-120b, openai/gpt-oss-120b, openai/gpt-oss-20b, gemini-2.5-flash).
TRIAGE_MODEL=
KNOWLEDGE_MODEL=
WRITER_MODEL=
GEMINI_MODEL=
# 0 turns off the on-disk cache of identical model calls (default: 1).
LLM_CACHE=
# 1 skips the models and uses the rule-based fallbacks only (default: 0).
LLM_OFFLINE=
# Seconds: request timeout (default 60) and the longest back-off on a rate limit (default 60).
LLM_TIMEOUT=
LLM_MAX_WAIT=
